# Google Gemini API key (free tier from https://aistudio.google.com/apikey) — used by /api/generate-content
GEMINI_API_KEY=

# Cloudflare Workers AI — used by /api/generate-image
# Account ID: dash.cloudflare.com → right sidebar → "Account ID"
CLOUDFLARE_ACCOUNT_ID=
# API token with Workers AI permission: dash.cloudflare.com → My Profile → API Tokens
CLOUDFLARE_API_TOKEN=

# Public site URL (e.g. http://localhost:3000 or https://yourdomain.com)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
